#!/bin/sh
# Thingstudio launcher (packaging/launcher/thingstudio). Runs the backend with the Python bundled beside
# this script, so nothing needs installing first. The installer links this file onto PATH, so symlinks
# are followed back to the real folder. -I: ignore the user's PYTHONPATH/PYTHONHOME and user site-packages,
# which would otherwise leak another Python's packages into this one.
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
here="$(cd "$(dirname "$self")" && pwd)" || exit 1
# macOS bundles carry thingstudio-python (python3 plus an embedded Info.plist, so macOS asks for Local
# Network permission instead of silently refusing); other platforms use python3.
py="$here/python/bin/thingstudio-python"
[ -x "$py" ] || py="$here/python/bin/python3"
if [ ! -x "$py" ]; then
  echo "Thingstudio: its bundled Python is missing ($py). Reinstall Thingstudio." >&2
  exit 1
fi
exec "$py" -I -m thingstudio_backend "$@"
