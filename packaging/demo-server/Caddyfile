# ThingStudio online editor: static files only. Web Serial is allowed for this origin only (Permissions-Policy
# serial=(self)): the install page and, later, the editor reach a board over USB from the browser (docs/working-notes/online-editor-demo-scoping.md).
#
# Serves <root>/current, which tools/deploy_demo.sh points at the release in use. It sits behind Pangolin: Pangolin's
# Traefik terminates TLS for demo.thingstudio.net and forwards plain HTTP down its tunnel to this server's port 8080,
# so Caddy does no TLS of its own. Check after any change: `caddy validate --config Caddyfile`, then `caddy reload`.
#
# tools/demo_request_check.py reads the Content-Security-Policy line below and tests the demo against it, so
# this file is the one place the policy is written. Keep it on one line, in double quotes.

{
	# TLS is Pangolin's job; Caddy only serves files over plain HTTP.
	auto_https off
	servers {
		# Requests arrive from Pangolin's tunnel (a private address). Trust its forwarded header, so the access
		# log's client_ip is the visitor, not the tunnel.
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

:8080 {
	root * /srv/thingstudio-demo/current
	encode zstd gzip

	# The editor moved to web.thingstudio.net (Mike, 2026-11-18). demo.thingstudio.net stays in Pangolin, pointing
	# here, and is sent on: it's in the Hacker News and Product Hunt threads.
	@demo host demo.thingstudio.net
	redir @demo https://web.thingstudio.net{uri} 301

	# Static files, no directory listing (no `browse`), nothing else. /install is the install page, install.html.
	try_files {path} {path}.html
	file_server

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; worker-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "serial=(self), usb=(), hid=(), camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Streaming WebAssembly compile refuses any other type. Caddy already maps .wasm this way; set it anyway.
	@wasm path *.wasm
	header @wasm Content-Type "application/wasm"

	# Vite names everything under /assets/ by its content hash, so it can be cached for good. index.html and the
	# unhashed files (the vendored WASM, icons) are checked again on each visit, so a new release shows at once.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-cache"

	# Access log, kept 3 days, with no IP addresses at all (Mike, 2026-11-18): the remote and client addresses are
	# deleted, not masked. GoatCounter counts page views from it (`goatcounter import -format caddy`), with no script
	# on the page. Check what the import makes of lines with no address: it may lose unique-visitor counts.
	log {
		output file /var/log/caddy/thingstudio-demo.access.log {
			roll_keep_for 72h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				# The proxy in front of Caddy adds these with the full client address (found 2026-11-18: every
				# line had a full IP), so they go too.
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
			}
		}
	}
}
