    {
      "id": "px-anim",
      "type": "thingstudio/function",
      "properties": {
        "code": "# One frame for a single pixel. The BOOT button picks the mode (flow 'mode').\nB = 64       # brightness cap, 0-255\n\nf = context.get('f', 0) + 1\ncontext.set('f', f)\nmode = flow.get('mode', 0)\n\ndef wheel(p):\n    # Colour wheel 0-255 -> (r, g, b): red -> green -> blue -> red.\n    p = p % 256\n    if p < 85:\n        return (255 - p * 3, p * 3, 0)\n    if p < 170:\n        p -= 85\n        return (0, 255 - p * 3, p * 3)\n    p -= 170\n    return (p * 3, 0, 255 - p * 3)\n\ndef pack(rgb, level):\n    # (r, g, b) at level 0-255 of the brightness cap -> 0xRRGGBB\n    r, g, b = rgb\n    k = B * level // 255\n    return ((r * k // 255) << 16) | ((g * k // 255) << 8) | (b * k // 255)\n\nif mode == 0:\n    # Colour cycle: once round the wheel about every 4 seconds.\n    msg['payload'] = pack(wheel(f * 3), 255)\nelif mode == 1:\n    # Breathe: fade up and down, a new colour each breath.\n    t = f % 100\n    level = t * 255 // 50 if t < 50 else (100 - t) * 255 // 50\n    msg['payload'] = pack(wheel((f // 100) * 40), level)\nelse:\n    # Police: two red flashes, two blue flashes.\n    t = f % 20\n    on = t in (0, 2, 10, 12)\n    msg['payload'] = pack((255, 0, 0) if t < 10 else (0, 0, 255), 255 if on else 0)\nreturn msg\n",
        "outputCount": 1,
        "label": "animate"
      }
    },
    {
      "id": "px-boot",
      "type": "thingstudio/ebutton",
      "properties": {
        "pin": 3,
        "suppress": false,
        "senseMode": "auto",
        "debounceMs": 50,
        "longPressMs": 1000,
        "doubleClickMs": 400,
        "pull": "up"
      }
    },
    {
      "id": "px-next",
      "type": "thingstudio/function",
      "properties": {
        "code": "# BOOT button: each press steps to the next effect.\nif msg['payload'] != 'press':\n    return None\nnames = ['colour cycle', 'breathe', 'police']\nmode = (flow.get('mode', 0) + 1) % len(names)\nflow.set('mode', mode)\nmsg['payload'] = names[mode]\nreturn msg\n",
        "outputCount": 1,
        "label": "next effect"
      }
    },
