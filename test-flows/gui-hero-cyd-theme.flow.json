{
  "formatVersion": 1,
  "flowName": "gui-hero-cyd-theme",
  "nodes": [
    {
      "id": "n01-sensor",
      "type": "thingstudio/timer",
      "properties": {
        "intervalMs": 2000
      }
    },
    {
      "id": "n02-split",
      "type": "thingstudio/function",
      "properties": {
        "code": "# Fake readings (no BME280 wired): slow triangle waves from the tick count.\nk = msg['payload']\nw = k % 40\nw = w if w < 20 else 40 - w\nt = {'topic': 'temperature', 'payload': 15 + w * 0.6}\nh = {'topic': 'humidity', 'payload': 40 + w * 2}\np = {'topic': 'pressure', 'payload': 990 + w * 2}\nok = {'topic': 'sensor', 'payload': k % 2 == 0}\nreturn [t, h, p, ok]\n",
        "outputCount": 4
      }
    },
    {
      "id": "n03-temp",
      "type": "thingstudio/gui_readout",
      "properties": {
        "name": "Temperature",
        "units": "°C",
        "decimals": 1,
        "lo": -20,
        "hi": 50,
        "staleAfter": 15,
        "caption": "Temperature"
      }
    },
    {
      "id": "n04-hum",
      "type": "thingstudio/gui_readout",
      "properties": {
        "name": "Humidity",
        "units": "%",
        "decimals": 0,
        "lo": 0,
        "hi": 100,
        "staleAfter": 15,
        "caption": "Humidity"
      }
    },
    {
      "id": "n05-press",
      "type": "thingstudio/gui_readout",
      "properties": {
        "name": "Pressure",
        "units": "hPa",
        "decimals": 0,
        "lo": 900,
        "hi": 1100,
        "staleAfter": 15,
        "caption": "Pressure"
      }
    },
    {
      "id": "n06-hist",
      "type": "thingstudio/gui_trend",
      "properties": {
        "name": "Pressure history",
        "lo": 950,
        "hi": 1050,
        "columns": 40,
        "colWidth": 3,
        "height": 40,
        "staleAfter": 15
      }
    },
    {
      "id": "n07-alive",
      "type": "thingstudio/gui_led",
      "properties": {
        "name": "Sensor",
        "staleAfter": 15,
        "style": "chip",
        "onText": "OK",
        "offText": "Off"
      }
    },
    {
      "id": "n08-tick",
      "type": "thingstudio/timer",
      "properties": {
        "intervalMs": 8000
      }
    },
    {
      "id": "n09-next",
      "type": "thingstudio/function",
      "properties": {
        "code": "msg['payload'] = 'next'\nreturn msg\n",
        "outputCount": 1
      }
    },
    {
      "id": "n10-nav",
      "type": "thingstudio/gui_navigator",
      "properties": {
        "name": "nav",
        "screen": ""
      }
    },
    {
      "id": "n11-navdbg",
