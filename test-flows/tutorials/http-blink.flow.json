{
  "formatVersion": 1,
  "flowName": "http-blink",
  "nodes": [
    {
      "id": "httpbl0wifistat01",
      "type": "thingstudio/wifi_status",
      "properties": {
        "pollMs": 5000,
        "wifiConfigId": "httpb0wifi0000001"
      }
    },
    {
      "id": "httpbl0debug00002",
      "type": "thingstudio/debug",
      "properties": {}
    },
    {
      "id": "httpbl0timer00003",
      "type": "thingstudio/timer",
      "properties": {
        "intervalMs": 500
      }
    },
    {
      "id": "httpbl0funct00004",
      "type": "thingstudio/function",
      "properties": {
        "code": "on = not context.get('on', False)\ncontext.set('on', on)\nmsg['payload'] = on\nreturn msg",
        "outputCount": 1
      }
    },
    {
      "id": "httpbl0httpin00005",
      "type": "thingstudio/http_in",
      "properties": {
        "port": 9999,
        "path": "/toggle",
        "method": "GET",
        "responseTimeoutMs": 10000,
        "wifiConfigId": "httpb0wifi0000001"
      }
    },
    {
      "id": "httpbl0funct00006",
      "type": "thingstudio/function",
      "properties": {
        "code": "on = not context.get('on', False)\ncontext.set('on', on)\nmsg['payload'] = on\nreply = dict(msg)\nreply['payload'] = 'LED ' + ('on' if on else 'off')\nreturn [msg, reply]",
        "outputCount": 2
      }
    },
    {
      "id": "httpbl0gpio00007",
      "type": "thingstudio/gpio_out",
      "properties": {
        "pin": 15
      }
    },
    {
      "id": "httpbl0respon00008",
      "type": "thingstudio/http_response",
      "properties": {}
    }
  ],
