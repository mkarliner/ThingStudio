{
 "formatVersion": 1,
 "flowName": "climate",
 "nodes": [
  {
   "id": "mqtt-temp",
   "type": "thingstudio/mqtt_subscribe",
   "properties": {
    "topic": "home/temp",
    "qos": 0,
    "brokerConfigId": "cfg-mqtt"
   }
  },
  {
   "id": "mqtt-hum",
   "type": "thingstudio/mqtt_subscribe",
   "properties": {
    "topic": "home/humidity",
    "qos": 0,
    "brokerConfigId": "cfg-mqtt"
   }
  },
  {
   "id": "fn-temp",
   "type": "thingstudio/function",
   "properties": {
    "code": "try:\n    v = float(msg['payload'])\nexcept (ValueError, TypeError):\n    return None\nreturn {'topic': 'temperature', 'payload': v}\n",
    "outputCount": 1
   }
  },
  {
   "id": "fn-hum",
   "type": "thingstudio/function",
   "properties": {
    "code": "try:\n    v = float(msg['payload'])\nexcept (ValueError, TypeError):\n    return None\nreturn {'topic': 'humidity', 'payload': v}\n",
    "outputCount": 1
   }
  },
  {
   "id": "fn-alarm",
   "type": "thingstudio/function",
   "properties": {
    "code": "v = msg['payload']\nhot = v > 28\nif hot == context.get('hot'):\n    return None\ncontext['hot'] = hot\nif hot:\n    return [{'topic': 'alarm', 'payload': 'Temperature above 28'}, None]\nreturn [None, {'topic': 'alarm', 'payload': None}]\n",
    "outputCount": 2
   }
  },
  {
   "id": "ro-temp",
   "type": "thingstudio/gui_readout",
   "properties": {
    "name": "Temperature",
    "units": "\u00b0C",
    "decimals": 1,
    "lo": -30,
    "hi": 60,
    "staleAfter": 0
   }
  },
  {
   "id": "ro-hum",
   "type": "thingstudio/gui_readout",
   "properties": {
    "name": "Humidity",
    "units": "%",
    "decimals": 0,
    "lo": 0,
    "hi": 100,
    "staleAfter": 0
   }
  },
  {
   "id": "jr",
   "type": "thingstudio/journal",
   "properties": {
    "rows": 120,
    "stepSeconds": 60,
    "steps": 0,
    "xff": 0.5
   }
  },
  {
   "id": "tr",
   "type": "thingstudio/gui_trend",
   "properties": {
    "name": "Temp 2h",
    "lo": 0,
    "hi": 40,
    "columns": 120,
    "colWidth": 2,
    "height": 200
   }
  },
  {
   "id": "btn-trend",
   "type": "thingstudio/gui_button",
   "properties": {
    "name": "trend",
    "mode": "navigate",
    "text": "Trend",
    "target": "trend",
    "maxChars": 8
   }
  },
  {
   "id": "btn-now",
   "type": "thingstudio/gui_button",
   "properties": {
    "name": "now",
    "mode": "navigate",
    "text": "Back",
    "target": "now",
    "maxChars": 8
   }
  },
  {
   "id": "modal",
   "type": "thingstudio/gui_modal",
   "properties": {
    "name": "Too hot",
    "screen": "screen",
    "priority": 0,
    "timeout": 0
   }
  },
  {
   "id": "screen",
   "type": "thingstudio/gui_screen",
   "properties": {
    "name": "tft",
    "width": 320,
    "height": 480,
    "frameFormat": "rgb565",
    "minInterval": 200,
    "wrap": true,
    "touchPanelConfigId": "cfg-touch-panel"
   }
  },
  {
   "id": "display",
   "type": "thingstudio/display_spi",
   "properties": {
    "controller": "st7796",
    "frameFormat": "rgb565",
    "spiBus": 1,
    "baudrate": 40000000,
    "sck": 12,
    "mosi": 11,
    "dc": 46,
    "cs": 10,
    "reset": -1,
    "backlight": 45,
    "width": 320,
    "height": 480,
    "rotation": 1,
    "xstart": -1,
    "ystart": -1,
    "colorOrder": "bgr",
    "invertColors": true,
    "dataLatchOrder": true
   }
  }
 ],
 "edges": [
