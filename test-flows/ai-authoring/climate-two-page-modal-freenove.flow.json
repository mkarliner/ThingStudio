 "configs": [
  {
   "id": "cfg-touch-i2c",
   "type": "thingstudio/config/i2c-bus",
   "properties": {
    "bus": 0,
    "scl": 15,
    "sda": 16,
    "freq": 400000
   }
  },
  {
   "id": "cfg-touch-panel",
   "type": "thingstudio/config/touch-panel",
   "properties": {
    "controller": "ft6336u",
    "i2cConfigId": "cfg-touch-i2c",
    "address": "0x38",
    "rstPin": 18,
    "pollMs": 20,
    "width": 320,
    "height": 480,
    "swapXY": false,
    "flipX": false,
    "flipY": false
   }
  },
  {
   "id": "cfg-wifi",
   "type": "thingstudio/config/wifi",
   "properties": {
    "credentialName": "home",
    "security": "password"
   }
  },
  {
   "id": "cfg-mqtt",
   "type": "thingstudio/config/mqtt-broker",
   "properties": {
    "credentialName": "lan-broker"
   }
  }
 ],
