{
  "formatVersion": 1,
  "flowName": "desk lamp",
  "nodes": [
    {
      "id": "n12-screen",
      "type": "thingstudio/gui_screen",
      "properties": {
        "name": "tft",
        "width": 320,
        "height": 480,
        "frameFormat": "rgb565",
        "minInterval": 200,
        "wrap": true,
        "touchPanelConfigId": "cfg-touch-panel"
      }
    },
    {
      "id": "n13-display",
      "type": "thingstudio/display_spi",
      "properties": {
        "controller": "st7796",
        "frameFormat": "rgb565",
        "spiBus": 1,
        "baudrate": 40000000,
        "sck": 12,
        "mosi": 11,
        "dc": 46,
        "cs": 10,
        "reset": -1,
        "backlight": 45,
        "width": 320,
        "height": 480,
        "rotation": 1,
        "xstart": -1,
        "ystart": -1,
        "colorOrder": "bgr",
        "invertColors": true,
        "dataLatchOrder": true,
        "orientation": "90"
      }
    },
    {
      "id": "n31-plugstate",
      "type": "thingstudio/mqtt_subscribe",
      "properties": {
        "topic": "stat/desklamp/POWER",
        "qos": 0,
        "brokerConfigId": "cfg-mqtt"
      }
    },
    {
      "id": "n32-plugcmd",
      "type": "thingstudio/mqtt_publish",
      "properties": {
        "topic": "cmnd/desklamp/POWER",
        "retain": false,
        "qos": 0,
        "brokerConfigId": "cfg-mqtt"
      }
    },
    {
      "id": "n33-plug",
      "type": "thingstudio/gui_button",
      "properties": {
        "name": "lamp",
        "mode": "toggle",
        "valueType": "string",
        "onValue": "ON",
        "offValue": "OFF",
        "onText": "ON",
        "offText": "OFF",
        "fireOn": "release",
        "pendingTimeout": 5,
        "maxChars": 8
      }
    }
  ],
  "edges": [
    [
      "n31-plugstate",
      0,
      "n33-plug",
      0
    ],
    [
      "n33-plug",
      0,
      "n32-plugcmd",
      0
    ],
    [
      "n12-screen",
      0,
      "n13-display",
      0
    ]
  ],
  "layout": {
    "n31-plugstate": {
      "pos": [
        80,
        80
      ]
    },
    "n33-plug": {
      "pos": [
        300,
        80
      ]
    },
    "n32-plugcmd": {
      "pos": [
        520,
        80
      ]
    },
    "n12-screen": {
      "pos": [
        80,
        220
      ]
    },
    "n13-display": {
      "pos": [
        300,
        220
      ]
    }
  },
  "configs": [
    {
      "id": "cfg-touch-i2c",
      "type": "thingstudio/config/i2c-bus",
      "properties": {
        "bus": 0,
        "scl": 15,
        "sda": 16,
        "freq": 400000
      }
    },
    {
      "id": "cfg-touch-panel",
      "type": "thingstudio/config/touch-panel",
      "properties": {
        "controller": "ft6336u",
        "i2cConfigId": "cfg-touch-i2c",
        "address": "0x38",
        "rstPin": 18,
        "pollMs": 20,
        "width": 320,
        "height": 480,
        "swapXY": false,
        "flipX": false,
        "flipY": false
      }
    },
    {
      "id": "cfg-wifi",
      "type": "thingstudio/config/wifi",
      "properties": {
        "credentialName": "home",
        "security": "password"
      }
    },
    {
      "id": "cfg-mqtt",
      "type": "thingstudio/config/mqtt-broker",
      "properties": {
        "credentialName": "lan-broker"
      }
    }
  ],
  "screens": {
    "n12-screen": {
      "pages": [
        {
          "name": "lamp",
          "root": {
            "kind": "column",
            "gap": 8,
            "padding": 8,
            "children": [
              {
                "kind": "text",
                "text": "Desk lamp",
                "font": "font_body24",
                "alignSelf": "center"
              },
              {
                "kind": "widget",
                "node": "n33-plug",
                "font": "font_body24",
                "alignSelf": "stretch",
                "grow": 1
              }
            ]
          }
        }
      ]
    }
  },
  "notes": "Toggle follows the plug's real state: stat/desklamp/POWER -> toggle -> cmnd/desklamp/POWER. Credentials: wifi 'home', broker 'lan-broker'."
}