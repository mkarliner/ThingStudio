{
  "formatVersion": 1,
  "flowName": "gui-headliner-sensor-freenove-s3-4in",
  "nodes": [
    {
      "id": "n01-sensor",
      "type": "thingstudio/bme280",
      "properties": {
        "i2cConfigId": "cfg-i2c",
        "address": 118,
        "intervalMs": 5000
      }
    },
    {
      "id": "n02-split",
      "type": "thingstudio/function",
      "properties": {
        "code": "# One BME280 reading in; one value out each way. A BMP280 has no humidity, so that output stays quiet.\np = msg['payload']\nt = {'topic': 'temperature', 'payload': p['temperature']}\nh = None\nif p['humidity'] is not None:\n    h = {'topic': 'humidity', 'payload': p['humidity']}\npr = {'topic': 'pressure', 'payload': p['pressure']}\nok = {'topic': 'sensor', 'payload': True}\nreturn [t, h, pr, pr, ok]\n",
        "outputCount": 5
      }
    },
    {
      "id": "n03-temp",
      "type": "thingstudio/gui_readout",
      "properties": {
        "name": "Temperature",
        "units": "\u00b0C",
        "decimals": 1,
        "lo": -20,
        "hi": 50,
        "staleAfter": 15
      }
    },
    {
      "id": "n04-hum",
      "type": "thingstudio/gui_readout",
      "properties": {
        "name": "Humidity",
        "units": "%",
        "decimals": 0,
        "lo": 0,
        "hi": 100,
        "staleAfter": 15
      }
    },
    {
      "id": "n05-press",
      "type": "thingstudio/gui_readout",
      "properties": {
        "name": "Pressure",
        "units": "hPa",
        "decimals": 0,
        "lo": 900,
        "hi": 1100,
        "staleAfter": 15
      }
    },
    {
      "id": "n06-pbar",
      "type": "thingstudio/gui_trend",
