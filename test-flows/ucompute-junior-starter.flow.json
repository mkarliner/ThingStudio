{
  "formatVersion": 1,
  "flowName": "ucompute-junior-starter",
  "notes": "Starter flow for JP Michon's uCompute Junior with a Pico W (choose 'uCompute Junior (Pico / Pico W)' in the Board menu; the Pico 2 W entry works too).\n\n- The 240x240 screen shows the time and date from the internet (ntp), the last button pressed, and a count.\n- Right adds one, left takes one away, select sets the count back to 0. Every press beeps the buzzer.\n\nSetup:\n- Create a WiFi credential named 'home' in the editor. A plain Pico has no WiFi: the clock stays at -- but the buttons and buzzer still work.\n- The clock is UK time (UTC offset 0, UK/EU summer hour). Elsewhere, set the two ntp nodes' UTC offset and daylight saving (for Quebec: -5 and none, or add an hour in summer).\n\nScreen settings follow the maker's own code: SPI bus 0, SPI mode 3, no CS or backlight pin, colours inverted, rotation 1.\nButton thresholds are the maker's; if a press shows the wrong button on your unit, change them in the 'keys' function.",
  "nodes": [
    {
      "id": "tick",
      "type": "thingstudio/timer",
      "properties": {
        "intervalMs": 2000
      }
    },
    {
      "id": "ntp-time",
      "type": "thingstudio/ntp",
      "properties": {
        "server": "pool.ntp.org",
        "utcOffset": 0,
        "dst": "eu",
        "format": "time"
      }
    },
    {
      "id": "ntp-date",
      "type": "thingstudio/ntp",
      "properties": {
        "server": "pool.ntp.org",
        "utcOffset": 0,
        "dst": "eu",
        "format": "date"
      }
    },
    {
      "id": "clock",
      "type": "thingstudio/gui_label",
      "properties": {
        "name": "Clock",
        "maxChars": 5,
        "staleAfter": 0
      }
    },
    {
      "id": "date",
      "type": "thingstudio/gui_label",
      "properties": {
        "name": "Date",
        "maxChars": 10,
        "staleAfter": 0
      }
    },
    {
      "id": "buttons",
      "type": "thingstudio/adc",
      "properties": {
        "pin": 26,
        "mode": "relative",
        "delta": 3000,
        "pollMs": 0
      }
    },
    {
      "id": "keys",
      "type": "thingstudio/function",
      "properties": {
        "code": "# The Junior's three buttons share GP26 through a resistor ladder, so one adc reading says which is down.\n# Thresholds from the maker's own code (read_u16): right < 7000, select < 12000, left < 16000, idle > 40000.\nraw = msg['payload']['raw']\nif raw < 7000:\n    key = 'right'\nelif raw < 12000:\n    key = 'select'\nelif raw < 16000:\n    key = 'left'\nelif raw > 40000:\n    key = None\nelse:\n    return None  # between a press and idle: wait for a clear reading\nlast = context.get('key', None)\ncontext.set('key', key)\nif key is None or last is not None:\n    return None  # a release, or the same press still held\ncount = context.get('count', 0)\nif key == 'right':\n    count += 1\nelif key == 'left':\n    count -= 1\nelse:\n    count = 0\ncontext.set('count', count)\nreturn [{'topic': 'key', 'payload': key}, {'topic': 'count', 'payload': count},\n        {'topic': 'beep', 'payload': 0.5}, {'topic': 'beep', 'payload': 0}]  # buzzer on, then off after 'beep length'\n",
        "outputCount": 4
      }
    },
    {
      "id": "last",
      "type": "thingstudio/gui_label",
      "properties": {
        "name": "Last button",
        "maxChars": 6,
        "staleAfter": 0
      }
    },
    {
      "id": "count",
      "type": "thingstudio/gui_readout",
      "properties": {
        "name": "Count",
        "units": "",
        "decimals": 0,
        "lo": -99,
        "hi": 99,
        "staleAfter": 0
      }
    },
    {
      "id": "beep-len",
      "type": "thingstudio/delay",
      "properties": {
        "delayMs": 80
      }
    },
    {
      "id": "buzzer",
      "type": "thingstudio/pwm_out",
      "properties": {
        "pin": 11,
        "freq": 2000
      }
    },
    {
      "id": "screen",
      "type": "thingstudio/gui_screen",
      "properties": {
        "name": "screen",
        "minInterval": 200,
        "wrap": true,
        "gridColumns": 12,
        "gridRows": 12
      }
    },
    {
      "id": "display",
      "type": "thingstudio/display_spi",
      "properties": {
        "controller": "st7789",
        "frameFormat": "gs4",
        "spiBus": 0,
        "baudrate": 20000000,
        "spiMode": 3,
        "sck": 2,
        "mosi": 3,
        "dc": 5,
        "cs": -1,
        "reset": 4,
        "backlight": -1,
        "width": 240,
        "height": 240,
        "rotation": 1,
        "colorOrder": "bgr",
        "invertColors": true,
        "dataLatchOrder": true,
        "xstart": -1,
        "ystart": -1
      }
    }
  ],
  "edges": [
    [
      "tick",
      0,
      "ntp-time",
      0
    ],
    [
      "tick",
      0,
      "ntp-date",
      0
    ],
    [
      "ntp-time",
      0,
      "clock",
      0
    ],
    [
      "ntp-date",
      0,
      "date",
      0
    ],
    [
      "buttons",
      0,
      "keys",
      0
    ],
    [
      "keys",
      0,
      "last",
      0
    ],
    [
      "keys",
      1,
      "count",
      0
    ],
    [
      "keys",
      2,
      "buzzer",
      0
    ],
    [
      "keys",
      3,
      "beep-len",
      0
    ],
    [
      "beep-len",
      0,
      "buzzer",
      0
    ],
    [
      "screen",
      0,
      "display",
      0
    ]
  ],
  "configs": [
    {
      "id": "cfg-wifi",
      "type": "thingstudio/config/wifi",
      "properties": {
        "credentialName": "home",
        "security": "password"
      }
    }
  ],
  "screens": {
    "screen": {
      "pages": [
        {
          "name": "main",
          "elements": [
            {
              "kind": "widget",
              "node": "clock",
              "row": 0,
              "col": 0,
              "rowSpan": 4,
              "colSpan": 12
            },
            {
              "kind": "widget",
              "node": "date",
              "row": 4,
              "col": 0,
              "rowSpan": 1,
              "colSpan": 12
            },
            {
              "card": true,
              "row": 6,
              "col": 0,
              "rowSpan": 6,
              "colSpan": 12
            },
            {
              "kind": "text",
              "text": "Button",
              "row": 6,
              "col": 0,
              "rowSpan": 1,
              "colSpan": 6
            },
            {
              "kind": "widget",
              "node": "last",
              "row": 7,
              "col": 0,
              "rowSpan": 2,
              "colSpan": 12
            },
            {
              "kind": "text",
              "text": "Count",
              "row": 9,
              "col": 0,
              "rowSpan": 1,
              "colSpan": 6
            },
            {
              "kind": "widget",
              "node": "count",
              "row": 10,
              "col": 0,
              "rowSpan": 2,
              "colSpan": 12
            }
          ]
        }
      ]
    }
  },
