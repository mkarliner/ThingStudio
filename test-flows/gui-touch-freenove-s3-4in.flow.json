{
  "formatVersion": 1,
  "flowName": "gui-touch-freenove-s3-4in",
  "nodes": [
    {
      "id": "n01-sensor",
      "type": "thingstudio/timer",
      "properties": {
        "intervalMs": 2000
      }
    },
    {
      "id": "n02-split",
      "type": "thingstudio/function",
      "properties": {
        "code": "# Fake readings (no BME280 wired): slow triangle waves from the tick count.\nk = msg['payload']\nw = k % 40\nw = w if w < 20 else 40 - w\nt = {'topic': 'temperature', 'payload': 15 + w * 0.6}\nh = {'topic': 'humidity', 'payload': 40 + w * 2}\np = {'topic': 'pressure', 'payload': 990 + w * 2}\nok = {'topic': 'sensor', 'payload': k % 2 == 0}\nreturn [t, h, p, ok]\n",
        "outputCount": 4
      }
    },
    {
      "id": "n03-temp",
      "type": "thingstudio/gui_readout",
      "properties": {
        "name": "Temperature",
        "units": "°C",
        "decimals": 1,
        "lo": -20,
        "hi": 50,
        "staleAfter": 15
      }
    },
    {
      "id": "n04-hum",
      "type": "thingstudio/gui_readout",
      "properties": {
        "name": "Humidity",
        "units": "%",
        "decimals": 0,
        "lo": 0,
        "hi": 100,
        "staleAfter": 15
      }
    },
    {
      "id": "n05-press",
      "type": "thingstudio/gui_readout",
      "properties": {
        "name": "Pressure",
        "units": "hPa",
        "decimals": 0,
        "lo": 900,
        "hi": 1100,
        "staleAfter": 15
      }
    },
    {
      "id": "n06-pbar",
      "type": "thingstudio/gui_bar",
      "properties": {
        "name": "Pressure bar",
        "lo": 950,
        "hi": 1050,
        "staleAfter": 15
      }
    },
    {
      "id": "n07-alive",
      "type": "thingstudio/gui_led",
      "properties": {
        "name": "Sensor",
        "staleAfter": 15
      }
    },
    {
      "id": "n12-screen",
      "type": "thingstudio/gui_screen",
      "properties": {
        "name": "tft",
        "minInterval": 200,
        "wrap": true,
        "touchPanelConfigId": "cfg-touch-panel",
        "gridColumns": 12,
        "gridRows": 0
      }
    },
    {
      "id": "n13-display",
      "type": "thingstudio/display_spi",
      "properties": {
        "controller": "st7796",
        "frameFormat": "rgb565",
        "spiBus": 1,
        "baudrate": 40000000,
        "sck": 12,
        "mosi": 11,
        "dc": 46,
        "cs": 10,
        "reset": -1,
        "backlight": 45,
        "width": 320,
        "height": 480,
        "rotation": 1,
        "xstart": -1,
        "ystart": -1,
        "colorOrder": "bgr",
        "invertColors": true,
        "dataLatchOrder": true
      }
    },
    {
      "id": "n23-btn1",
      "type": "thingstudio/gui_button",
      "properties": {
        "name": "next page",
        "mode": "navigate",
        "text": "Next page",
        "target": "next",
        "maxChars": 8
      }
    },
    {
      "id": "n24-btn2",
      "type": "thingstudio/gui_button",
      "properties": {
        "name": "next page",
        "mode": "navigate",
        "text": "Next page",
        "target": "next",
        "maxChars": 8
      }
    },
    {
      "id": "n30-wifi",
      "type": "thingstudio/wifi_status",
      "properties": {
        "pollMs": 5000,
        "wifiConfigId": "cfg-wifi"
      }
    },
    {
      "id": "n31-plugstate",
      "type": "thingstudio/mqtt_subscribe",
      "properties": {
        "topic": "stat/plug/POWER",
        "qos": 0,
        "brokerConfigId": "cfg-mqtt"
      }
    },
    {
      "id": "n32-plugcmd",
      "type": "thingstudio/mqtt_publish",
      "properties": {
        "topic": "cmnd/plug/POWER",
        "retain": false,
        "qos": 0,
        "brokerConfigId": "cfg-mqtt"
      }
    },
    {
      "id": "n33-plug",
      "type": "thingstudio/gui_button",
      "properties": {
        "name": "plug",
        "mode": "toggle",
        "valueType": "string",
        "onValue": "ON",
        "offValue": "OFF",
        "onText": "ON",
        "offText": "OFF",
        "fireOn": "release",
        "pendingTimeout": 5,
        "maxChars": 8
      }
    },
    {
      "id": "n34-btn3",
