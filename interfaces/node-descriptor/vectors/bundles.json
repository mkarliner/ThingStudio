        { "library": "ts_ha", "origin": "bundle:home-assistant", "contains": "bundle:ha-fork" }
      ],
      "skippedBundles": [
        { "bundle": "ha-fork", "contains": "ts_ha" },
        { "bundle": "home-assistant", "contains": "ts_ha" }
      ]
    }
  },
