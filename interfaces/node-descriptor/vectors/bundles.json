      "custom-nodes/ha-fork/lib/ts_ha.py": "x = 1\n",
      "custom-nodes/home-assistant/y.node.json": "@node:sink",
      "custom-nodes/home-assistant/y.node.py": "@py:sink",
      "custom-nodes/home-assistant/lib/ts_ha.py": "x = 2\n"
    },
    "expect": {
      "packages": [],
