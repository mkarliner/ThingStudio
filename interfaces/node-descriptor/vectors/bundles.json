[
  {
    "name": "bundle-loads-with-library",
    "tree": {
      "custom-nodes/doubler.node.json": "@node:transform",
      "custom-nodes/doubler.node.py": "@py:transform",
      "custom-nodes/home-assistant/README.md": "ignored",
      "custom-nodes/home-assistant/ha_sensor.node.json": "@node:sink",
      "custom-nodes/home-assistant/ha_sensor.node.py": "@py:sink",
      "custom-nodes/home-assistant/ha_device.node.json": "@node:source",
      "custom-nodes/home-assistant/ha_device.node.py": "@py:source",
      "custom-nodes/home-assistant/lib/ts_ha.py": "import ts_mqtt\n"
    },
    "expect": {
      "packages": ["doubler", "ha_device", "ha_sensor"],
      "libraries": [{ "name": "ts_ha", "files": [["ts_ha.py", "ts_ha.py"]], "requires": ["ts_mqtt"], "origin": "bundle:home-assistant" }],
      "refused": [],
      "skippedBundles": []
    }
  },
  {
    "name": "broken-bundle-skipped-whole",
    "tree": {
      "custom-nodes/doubler.node.json": "@node:transform",
      "custom-nodes/doubler.node.py": "@py:transform",
      "custom-nodes/broken/good.node.json": "@node:sink",
      "custom-nodes/broken/good.node.py": "@py:sink",
      "custom-nodes/broken/half.node.json": "@node:sink",
      "custom-nodes/broken/lib/brokenlib.py": "x = 1\n"
    },
    "expect": {
      "packages": ["doubler"],
      "libraries": [],
      "refused": [],
      "skippedBundles": [{ "bundle": "broken", "contains": "half.node.py" }]
    }
  },
  {
