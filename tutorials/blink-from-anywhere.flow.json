{
  "formatVersion": 1,
  "flowName": "blink from anywhere",
  "nodes": [
    {
      "id": "1",
      "type": "thingstudio/inject",
      "properties": {
        "payloadType": "string",
        "payloadValue": "pressed",
        "repeat": "manual"
      }
    },
    {
      "id": "2",
      "type": "thingstudio/mqtt_publish",
      "properties": {
        "topic": "thingstudio/change-this-number/button",
        "retain": false,
        "qos": 0,
        "brokerConfigId": "8e47a2b3-1c9d-4e60-b5f2-6a3d9c0e7b24",
        "wifiConfigId": "3c1d5f10-6b2e-4f7a-9a41-0d2b7e5c8a11"
      }
    },
    {
      "id": "3",
      "type": "thingstudio/mqtt_subscribe",
      "properties": {
        "topic": "thingstudio/change-this-number/led",
        "qos": 0,
        "brokerConfigId": "8e47a2b3-1c9d-4e60-b5f2-6a3d9c0e7b24",
        "wifiConfigId": "3c1d5f10-6b2e-4f7a-9a41-0d2b7e5c8a11"
      }
    },
    {
      "id": "4",
      "type": "thingstudio/function",
      "properties": {
        "code": "msg['payload'] = str(msg['payload']).lower() in ('on', '1', 'true')\nreturn msg",
        "outputCount": 1
      }
    },
