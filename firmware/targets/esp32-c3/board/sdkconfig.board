# SPDX-License-Identifier: Apache-2.0
# firmware/targets/esp32-c3/board/sdkconfig.board -- applied after the port's fragments (target.json), so these win.

# 4 MB, DIO: what C3 modules are sold with, and the mode the LuatOS ESP32C3-CORE's flash runs in.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# The partition table is board/partitions.csv; build.sh writes the sdkconfig lines that point at it.

# Frozen bytecode makes the app bigger than a stock build; optimise for size (sdkconfig.riscv already does).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
