# firmware/targets/classic-esp32/board/sdkconfig.board -- applied last, so these win over sdkconfig.base.

# 4 MB, the size every classic-ESP32 board this image targets is sold with (the CYD included).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# The partition table is board/partitions.csv; build.sh writes the sdkconfig lines that point at it.

# Frozen bytecode plus the GUI stack makes the app bigger than a stock build; optimise for size,
# the same trade the stock OTA variant makes.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
