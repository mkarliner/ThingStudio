{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "/tmp/ts-out"
  },
  "include": ["src/compiler/**/*.ts", "src/node-library/**/*.ts", "src/dev-tools/**/*.ts", "src/flow-file/flow-file.ts"]
}
