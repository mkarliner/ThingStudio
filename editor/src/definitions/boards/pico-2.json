{
  "name": "Raspberry Pi Pico 2",
  "processor": "rp2350",
  "wifi": false,
  "match": ["Raspberry Pi Pico2"],
  "gpio": ["0-29"],
  "pins": { "LED": 25 },
  "avoid": {
    "23": "Controls the power supply mode (SMPS).",
    "24": "Senses USB power (VBUS).",
    "29": "Measures the supply voltage (VSYS)."
  },
  "header": {
    "1": 0, "2": 1, "3": "GND", "4": 2, "5": 3,
    "6": 4, "7": 5, "8": "GND", "9": 6, "10": 7,
    "11": 8, "12": 9, "13": "GND", "14": 10, "15": 11,
    "16": 12, "17": 13, "18": "GND", "19": 14, "20": 15,
    "21": 16, "22": 17, "23": "GND", "24": 18, "25": 19,
    "26": 20, "27": 21, "28": "GND", "29": 22, "30": "RUN",
    "31": 26, "32": 27, "33": "AGND", "34": 28, "35": "ADC_VREF",
    "36": "3V3(OUT)", "37": "3V3_EN", "38": "GND", "39": "VSYS", "40": "VBUS"
  },
  "notes": "RP2350A, so GPIO 0-29 only. The onboard LED is GPIO 25."
}
